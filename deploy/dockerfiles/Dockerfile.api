# ===========================================================
# ski-api-server Dockerfile
# 多阶段构建:Stage 1 编译,Stage 2 运行(镜像更小)
# ===========================================================

# ===== Stage 1: 构建 =====
FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /build

# 先只拷贝 pom.xml 利用 Docker 层缓存
COPY pom.xml .
RUN mvn dependency:go-offline -B

# 拷贝源码并编译
COPY src ./src
RUN mvn clean package -DskipTests -B

# ===== Stage 2: 运行 =====
FROM eclipse-temurin:21-jre

# 时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /app

# 拷贝构建产物
COPY --from=builder /build/target/*.jar app.jar

# 创建数据目录(供视频存储挂载点用)
RUN mkdir -p /data/ski-data

# JVM 参数:容器化场景下推荐
# UseContainerSupport=true 让JVM感知容器内存限制
# MaxRAMPercentage=75 给JVM最多75%可用内存
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom"

EXPOSE 8080

# 用 spring 用户而非 root(安全)
RUN groupadd -r spring && useradd -r -g spring spring \
    && chown -R spring:spring /app /data/ski-data
USER spring

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
