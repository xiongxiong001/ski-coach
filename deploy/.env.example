# ===========================================================
# Ski Coach 部署环境变量模板
#
# 使用方法:
#   1. cp .env.example .env
#   2. 修改下面所有标记 ⚠️ MUST 的值
#   3. 不要把 .env 提交到 Git!
# ===========================================================

# ====== 端口 ======
# 通常不用改,除非你的服务器上端口被占用
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=8080
AI_PORT=8001
MYSQL_PORT=3306
REDIS_PORT=6379

# ====== 数据库 ======
# ⚠️ MUST 修改:生产环境用强密码
MYSQL_ROOT_PASSWORD=ChangeMe_StrongPassword_2026

# ====== Redis ======
# 生产环境建议设密码;本地开发可留空
REDIS_PASSWORD=
# 如果设了密码,Redis 启动参数:--requirepass xxx
# 如果留空,启动参数为空字符串
REDIS_PASSWORD_ARG=

# ====== JWT 密钥 ======
# ⚠️ MUST 修改:必须 32 位以上的随机字符串,生产前一定要改
# 用 `openssl rand -hex 32` 生成
JWT_USER_SECRET=ChangeMe_JwtUserSecret_NeedAtLeast32Characters!
JWT_ADMIN_SECRET=ChangeMe_JwtAdminSecret_NeedAtLeast32Characters!

# ====== DeepSeek LLM 配置 ======
# ⚠️ MUST 修改:在 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ====== 视频文件存储 ======
# 推荐:使用绝对路径
# Linux 服务器示例:/data/ski-data
# 本地 Mac:        /Users/yourname/ski-data
# 本地 Windows:    需要在 docker compose 之前创建好这个目录
VIDEO_DATA_PATH=./data/ski-data

# ====== 后台 Worker ======
# AI 任务并发数。机器 4 核给 2,8 核给 4-6
WORKER_THREAD_COUNT=2

# ====== 日志级别 ======
LOG_LEVEL=INFO
