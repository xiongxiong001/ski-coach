# ============================================================
# Ski AI Server 环境变量配置
# 使用方式: 复制此文件为 .env,填入真实值
# ============================================================

# ----------- 服务配置 -----------
# 监听地址和端口
HOST=0.0.0.0
PORT=8000

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 视频存储根目录(Java端共享的目录,Python只读)
# 安全起见,Python只能读取此目录下的文件
VIDEO_STORAGE_BASE_PATH=/data/ski_videos

# ----------- LLM 配置 -----------
# 选择provider: deepseek / openai / dashscope
USE_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI(可选)
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-4o-mini

# 通义千问(可选)
# DASHSCOPE_API_KEY=sk-xxxxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus

# ----------- 算法配置 -----------
# MediaPipe 模型复杂度: 0/1/2 (1是平衡选择)
POSE_MODEL_COMPLEXITY=1

# 姿态检测最低置信度阈值
POSE_MIN_DETECTION_CONFIDENCE=0.5

# 检测率低于此值时拒绝继续分析
MIN_DETECTION_RATE=0.2
